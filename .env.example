# ==============================
# Clerk Authentication
# ==============================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ==============================
# Stripe Payments
# ==============================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_xxxxx
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=price_xxxxx

# ==============================
# Supabase Database
# ==============================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyxxxxx

# ==============================
# Google Analytics
# ==============================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================
# App Config
# ==============================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NowBuild

# ==============================
# NowBuild Coding Agent
# ==============================
OPENROUTER_API_KEY=sk-or-v1-xxxxx
NOWBUILD_MODEL=deepseek/deepseek-v4-flash
# Platform-managed customer AI. These model defaults can be upgraded centrally
# without rebuilding generated products; customer projects never receive the key.
NOWBUILD_AI_TEXT_MODEL=~openai/gpt-latest
NOWBUILD_AI_IMAGE_MODEL=bytedance-seed/seedream-4.5
NOWBUILD_AI_VIDEO_MODEL=google/veo-3.1-fast
NOWBUILD_AI_SPEECH_MODEL=elevenlabs/eleven-turbo-v2
NOWBUILD_AI_TRANSCRIPTION_MODEL=openai/whisper-1
NOWBUILD_AI_SPEECH_USD_PER_1K_CHARS=0.03
# HMAC secret used for project-scoped deployment gateway tokens.
NOWBUILD_AI_GATEWAY_SECRET=replace_with_a_different_long_random_secret
# Public production URL used by deployed products to reach the managed gateway.
NOWBUILD_PUBLIC_URL=https://nowbuild.app
# Optional absolute path to a clean nowbuild-saas-kit checkout.
NOWBUILD_TEMPLATE_DIR=
# Charge end users provider cost multiplied by this value.
NOWBUILD_COST_MULTIPLIER=2
# Encrypts per-project Clerk, Stripe, Supabase and AI credentials at rest.
# Generate a long random value for production; changing it makes saved secrets unreadable.
NOWBUILD_SECRETS_KEY=replace_with_a_long_random_secret

# One-time Stripe prices for credit packs
NEXT_PUBLIC_STRIPE_STARTER_CREDITS_PRICE_ID=price_xxxxx
NEXT_PUBLIC_STRIPE_BUILDER_CREDITS_PRICE_ID=price_xxxxx
NEXT_PUBLIC_STRIPE_LAUNCH_CREDITS_PRICE_ID=price_xxxxx
